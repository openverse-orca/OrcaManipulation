  <!-- DEX1-1 齿轮耦合: 每个夹爪内部 q1=q2, 模拟单 M4010 电机驱动两指 -->
  <equality>
    <joint name="left_dex1_coupling" joint1="left_dex1_joint1" joint2="left_dex1_joint2" polycoef="0 1 0 0 0" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="right_dex1_coupling" joint1="right_dex1_joint1" joint2="right_dex1_joint2" polycoef="0 1 0 0 0" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <!-- 遥操姿态钉住约束(默认关闭, 遥操脚本启动时按当前姿态激活):
         用求解器内 equality 约束替代每步 qpos 写回。写回式钉住每毫秒把关节
         硬拉回参考值, 会向夹爪注入高频微振动, 破坏摩擦接触的动量守恒,
         导致夹持物以 ~10mm/s 匀速爬滑脱落(与摩擦系数大小无关);
         equality 钉住由求解器内部求解, 动量守恒, 抓取稳定。
         注: strip 任务模式烘焙删除腰/腿关节时, strip 流水线会自动移除
         引用被删关节的 pin_* 约束; 基座 weld 保持关闭, 不影响烘焙固定。 -->
    <weld name="pin_floating_base" body1="pelvis" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_waist_yaw_joint" joint1="waist_yaw_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_waist_roll_joint" joint1="waist_roll_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_waist_pitch_joint" joint1="waist_pitch_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_left_hip_pitch_joint" joint1="left_hip_pitch_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_left_hip_roll_joint" joint1="left_hip_roll_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_left_hip_yaw_joint" joint1="left_hip_yaw_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_left_knee_joint" joint1="left_knee_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_left_ankle_pitch_joint" joint1="left_ankle_pitch_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_left_ankle_roll_joint" joint1="left_ankle_roll_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_right_hip_pitch_joint" joint1="right_hip_pitch_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_right_hip_roll_joint" joint1="right_hip_roll_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_right_hip_yaw_joint" joint1="right_hip_yaw_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_right_knee_joint" joint1="right_knee_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_right_ankle_pitch_joint" joint1="right_ankle_pitch_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <joint name="pin_right_ankle_roll_joint" joint1="right_ankle_roll_joint" polycoef="0 0 0 0 0" active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>
  </equality>
