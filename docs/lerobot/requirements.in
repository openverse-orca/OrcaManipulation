# Python 3.12 / Linux x86-64：LeRobot 采集、回放、推理的直接依赖。
# 不要与根目录 requirements.txt（data_collection_tele.py HDF5）混用。
#
# 重新生成锁定文件（在本目录下）：
#   uv pip compile requirements.in --constraint constraints.txt \
#     --python-version 3.12 --python-platform x86_64-unknown-linux-gnu \
#     --generate-hashes --emit-index-url --index-strategy unsafe-best-match \
#     --no-emit-package numpy --no-emit-package scipy \
#     --no-emit-package argparse --output-file requirements.txt
#
# NumPy and SciPy use the validated Conda builds and are therefore excluded from
# the pip lock. Python 3.12 uses the standard-library argparse module.

--extra-index-url https://download.pytorch.org/whl/cpu

# Build tools for the three repository-owned source distributions.
setuptools==82.0.1
wheel==0.47.0

# Conda-owned numerical ABI (must already be present).
