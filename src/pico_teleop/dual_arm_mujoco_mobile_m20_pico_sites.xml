  <actuator>
    <!-- 底盘平面速度（浮动底座，原模型外观不变）：世界系 vx / vy / 偏航角速度 -->
    <motor name="drive_base_x" joint="base_slide_x" gear="600" ctrlrange="-2 2" forcerange="-500 500" />
    <motor name="drive_base_y" joint="base_slide_y" gear="600" ctrlrange="-2 2" forcerange="-500 500" />
    <motor name="drive_base_yaw" joint="base_yaw" gear="600" ctrlrange="-3 3" forcerange="-500 500" />
    <!-- 双臂纯力矩电机 motor（2026-10-08 演化：position -> velocity -> motor）。
         motor 力 = gear·v_cmd，本身无速度阻尼项（velocity 执行器另有 -kv·qvel）。
         为保持与 velocity 版逐自由度数学等价，速度阻尼移到关节 <joint damping>：
           J1-3  damping=60  = 旧 kv60；J4=13；J5/6 damping=3（=旧 kv1+原关节2）；
           底盘  damping=600 = 旧 kv600；夹爪 jaw_a damping=82（=旧 kv80+原关节2）。
         关节 damping 由 MuJoCo 隐式积分、无条件稳定（见上文腕部消振注释）。
         脚本 100Hz 位置外环 v_cmd=clip(Kp·(q_des-q),±Vmax)，等效位置刚度
         = gear·Kp，逐关节配平原 position kp：
           J1-3: 60×50=3000（伸展 τ_g~90Nm -> 下垂 ~12mm，不塌）
           J4  : 13×8≈104；J5-6: 1×55=55。
         离线 A/B 实测（真实模型+脚本外环）：motor+damping 与 velocity 版在重力
         锁定下垂、|qvel|峰值/RMS、J4 阶跃超调/320ms 调节时间/末段振荡上逐项
         完全一致（verify_motor_v1.py）。
         ctrlrange=关节速度命令(rad/s)：大臂 ±2、腕 ±3；forcerange 力矩上限不变。
         IK/锁定/复位仍只产出关节"目标角"，速度换算统一在脚本
         PicoDualArmController 内完成。改动需遥操实测回归验证。 -->
    <motor name="drive_left_elfin_joint1" joint="left_elfin_joint1" gear="60" ctrlrange="-2 2" forcerange="-500 500" />
    <motor name="drive_left_elfin_joint2" joint="left_elfin_joint2" gear="60" ctrlrange="-2 2" forcerange="-500 500" />
    <motor name="drive_left_elfin_joint3" joint="left_elfin_joint3" gear="60" ctrlrange="-2 2" forcerange="-500 500" />
    <motor name="drive_left_elfin_joint4" joint="left_elfin_joint4" gear="13" ctrlrange="-3 3" forcerange="-104 104" />
    <motor name="drive_left_elfin_joint5" joint="left_elfin_joint5" gear="1" ctrlrange="-3 3" forcerange="-34 34" />
    <motor name="drive_left_elfin_joint6" joint="left_elfin_joint6" gear="1" ctrlrange="-3 3" forcerange="-34 34" />
    <motor name="drive_right_elfin_joint1" joint="right_elfin_joint1" gear="60" ctrlrange="-2 2" forcerange="-500 500" />
    <motor name="drive_right_elfin_joint2" joint="right_elfin_joint2" gear="60" ctrlrange="-2 2" forcerange="-500 500" />
    <motor name="drive_right_elfin_joint3" joint="right_elfin_joint3" gear="60" ctrlrange="-2 2" forcerange="-500 500" />
    <motor name="drive_right_elfin_joint4" joint="right_elfin_joint4" gear="13" ctrlrange="-3 3" forcerange="-104 104" />
    <motor name="drive_right_elfin_joint5" joint="right_elfin_joint5" gear="1" ctrlrange="-3 3" forcerange="-34 34" />
    <motor name="drive_right_elfin_joint6" joint="right_elfin_joint6" gear="1" ctrlrange="-3 3" forcerange="-34 34" />
    <!-- M20 夹爪：每爪 1 个 motor 纯力矩电机驱动 jaw_a（单电机双指机构），
         jaw_b 由下方 equality 机械耦合跟随、相向对称闭合。
         开度位置由脚本 M20TriggerController 读 qpos 做速度闭环决定（无 position 伺服）。
         夹持力=失速力 gear·ctrl_max=80×0.05=4N/指（forcerange ±35N 是从未触及的
         上限）。motor 化后 jaw_a 关节 damping=82（=旧 velocity kv80+原关节2），
         与 velocity 版等价且为隐式阻尼、无条件稳定（不再受显式 kv<2m/dt 限制）。
         μ=5（2026-10-08 pad 摩擦 2→5）：摩擦锥 20N/指、双指 40N，对 200g 件
         20 倍裕度，治提升/晃动中的动态滑移（与静态爬滑不同，后者由 impratio=50
         治、与 μ 无关）；μ>10 易诱发接触抖动，5 为安全值。
         叠加运行时 noslip_iterations=3（脚本启动强制，MuJoCo 防滑后处理，
         每步把摩擦接触残余滑移速度归零，兜底一切滑移）。 -->
    <motor name="drive_left_m20_motor" joint="left_m20_jaw_a_slide" gear="80" ctrlrange="-0.05 0.05" forcerange="-35 35" />
    <motor name="drive_right_m20_motor" joint="right_m20_jaw_a_slide" gear="80" ctrlrange="-0.05 0.05" forcerange="-35 35" />
  </actuator>
  <equality>
    <!-- M20 单电机双指传动：jaw_b 与 jaw_a 等值耦合（两爪轴向相反 -> 相向对称闭合/张开） -->
    <joint joint1="left_m20_jaw_a_slide" joint2="left_m20_jaw_b_slide" polycoef="0 1 0 0 0" />
    <joint joint1="right_m20_jaw_a_slide" joint2="right_m20_jaw_b_slide" polycoef="0 1 0 0 0" />
  </equality>
</mujoco>
