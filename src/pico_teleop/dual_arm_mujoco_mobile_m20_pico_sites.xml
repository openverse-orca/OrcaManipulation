  <actuator>
    <!-- 底盘平面速度（浮动底座，原模型外观不变）：世界系 vx / vy / 偏航角速度 -->
    <velocity name="drive_base_x" joint="base_slide_x" kv="600" ctrlrange="-2 2" forcerange="-500 500" />
    <velocity name="drive_base_y" joint="base_slide_y" kv="600" ctrlrange="-2 2" forcerange="-500 500" />
    <velocity name="drive_base_yaw" joint="base_yaw" kv="600" ctrlrange="-3 3" forcerange="-500 500" />
    <!-- 双臂 -->
    <position name="drive_left_elfin_joint1" joint="left_elfin_joint1" kp="110" kv="13" ctrlrange="-3.14 3.14" forcerange="-500 500" />
    <position name="drive_left_elfin_joint2" joint="left_elfin_joint2" kp="110" kv="13" ctrlrange="-2.35 2.35" forcerange="-500 500" />
    <position name="drive_left_elfin_joint3" joint="left_elfin_joint3" kp="110" kv="13" ctrlrange="-2.61 2.61" forcerange="-500 500" />
    <position name="drive_left_elfin_joint4" joint="left_elfin_joint4" kp="110" kv="13" ctrlrange="-3.14 3.14" forcerange="-104 104" />
    <position name="drive_left_elfin_joint5" joint="left_elfin_joint5" kp="55" kv="1" ctrlrange="-2.56 2.56" forcerange="-34 34" />
    <position name="drive_left_elfin_joint6" joint="left_elfin_joint6" kp="55" kv="1" ctrlrange="-3.14 3.14" forcerange="-34 34" />
    <position name="drive_right_elfin_joint1" joint="right_elfin_joint1" kp="110" kv="13" ctrlrange="-3.14 3.14" forcerange="-500 500" />
    <position name="drive_right_elfin_joint2" joint="right_elfin_joint2" kp="110" kv="13" ctrlrange="-2.35 2.35" forcerange="-500 500" />
    <position name="drive_right_elfin_joint3" joint="right_elfin_joint3" kp="110" kv="13" ctrlrange="-2.61 2.61" forcerange="-500 500" />
    <position name="drive_right_elfin_joint4" joint="right_elfin_joint4" kp="110" kv="13" ctrlrange="-3.14 3.14" forcerange="-104 104" />
    <position name="drive_right_elfin_joint5" joint="right_elfin_joint5" kp="55" kv="1" ctrlrange="-2.56 2.56" forcerange="-34 34" />
    <position name="drive_right_elfin_joint6" joint="right_elfin_joint6" kp="55" kv="1" ctrlrange="-3.14 3.14" forcerange="-34 34" />
    <!-- M20 夹爪电机：每爪 1 个 velocity 电机驱动 jaw_a（单电机双指机构），
         jaw_b 由下方 equality 机械耦合跟随、相向对称闭合。
         不用 position 位置伺服：开度位置由脚本 M20TriggerController 读 qpos
         做速度闭环决定；夹持力上限由 forcerange ±35N 限住。 -->
    <velocity name="drive_left_m20_motor" joint="left_m20_jaw_a_slide" kv="20" ctrlrange="-0.05 0.05" forcerange="-35 35" />
    <velocity name="drive_right_m20_motor" joint="right_m20_jaw_a_slide" kv="20" ctrlrange="-0.05 0.05" forcerange="-35 35" />
  </actuator>
  <equality>
    <!-- M20 单电机双指传动：jaw_b 与 jaw_a 等值耦合（两爪轴向相反 -> 相向对称闭合/张开） -->
    <joint joint1="left_m20_jaw_a_slide" joint2="left_m20_jaw_b_slide" polycoef="0 1 0 0 0" />
    <joint joint1="right_m20_jaw_a_slide" joint2="right_m20_jaw_b_slide" polycoef="0 1 0 0 0" />
  </equality>
</mujoco>
