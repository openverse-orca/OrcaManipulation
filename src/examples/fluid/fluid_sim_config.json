{
  "description": "Fluid-MuJoCo 全链路配置：force_position + lag_compensated（与 OrcaPlayground run_fluid_sim.py 同参）",
  "build_mode": "release",
  "build_mode_comment": "release=日常/遥操；debug=CP/子步 CSV。CLI: --build-mode debug",
  "orcagym": {
    "address": "localhost:50051",
    "agent_name": "NoRobot",
    "env_name": "SimulationLoop"
  },
  "orcalink": {
    "enabled": true,
    "host": "localhost",
    "port": 50351,
    "auto_start": true,
    "startup_delay": 2,
    "command": "orcalink",
    "args": [],
    "client": {
      "session_id": 1,
      "client_name": "mujoco_client",
      "update_rate_hz": 50,
      "encoding": {
        "i_frame_interval": 30,
        "change_threshold": 0.0001
      },
      "session": {
        "control_mode": "sync",
        "expected_clients": 2,
        "ready_timeout_sec": 30.0,
        "grpc_call_timeout_sec": 5.0,
        "async_params": {
          "flow_control_enabled": true,
          "flow_control_window_size": 5,
          "speed_ratio_threshold": 1.5
        },
        "sync_params": {
          "sync_window_size": 1,
          "comment": "与短链一致；force_position 验证用 1"
        }
      }
    },
    "bridge": {
      "coupling_mode": "force_position",
      "force_position": {
        "channels": {
          "force": {
            "channel_id": 1,
            "publish": false,
            "subscribe": true,
            "comment": "MuJoCo 订阅 SPH 流体力（Ch1）"
          },
          "position": {
            "channel_id": 2,
            "publish": true,
            "subscribe": false,
            "comment": "MuJoCo 发布位姿+线速度（Ch2）"
          }
        }
      },
      "spring_constraint": {
        "channels": {
          "position": {
            "channel_id": 2,
            "publish": true,
            "subscribe": true
          }
        },
        "force_clamping": {
          "enabled": true,
          "rigid_body": {
            "enabled": true,
            "max_acceleration_g": 10.0,
            "discard_on_clamp": true
          },
          "debug": {
            "log_clamped_forces": false,
            "log_threshold_n": 1000.0
          }
        }
      },
      "multi_point_force": {
        "channels": {
          "position": {
            "channel_id": 2,
            "publish": true,
            "subscribe": false
          },
          "force": {
            "channel_id": 2,
            "publish": false,
            "subscribe": true
          }
        }
      }
    }
  },
  "orcasph": {
    "enabled": true,
    "auto_start": true,
    "command": "orcasph",
    "args": [],
    "scene_auto_generate": true,
    "config_template": "sph_sim_config.json",
    "sphscale": 1.0,
    "position_follow": {
      "scheme": "lag_compensated",
      "velocity_cap_mps": 1.0
    },
    "rigid_body_dynamics": {
      "mode": "external",
      "force_smoothing_alpha": 0.3
    }
  },
  "sph": {
    "scene_config": "scene_config.json",
    "include_fluid_blocks": true,
    "include_wall": true
  },
  "simulation": {
    "sync_mode": "force_position",
    "timestep": 0.001,
    "substeps": 1,
    "sph_timestep": 0.001,
    "sph_cfl_method": 0,
    "comment": "MuJoCo dt=0.001×20 宏步；SPH 固定 dt、cflMethod=0"
  },
  "debug": {
    "verbose_logging": false,
    "force_position_trace": {
      "enabled": false,
      "output_base_dir": "~/.orcagym/tmp/debug_data",
      "substeps_per_macro": 20,
      "substep_trace": {
        "enabled": false,
        "max_macros": 30
      },
      "comment": "debug 时 enabled=true 且 build_mode=debug（或 --build-mode debug）"
    }
  }
}
