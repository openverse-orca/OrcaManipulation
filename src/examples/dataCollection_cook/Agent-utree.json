    "right": {
      "palm_legacy": "gripper_r_palm",
      "palm_suffix": "wrist_yaw_link",
      "finger1_legacy": "gripper_r_finger1",
      "finger1_suffix": "hand_index_0_link",
      "finger2_legacy": "gripper_r_finger2",
      "finger2_suffix": "hand_middle_0_link"
