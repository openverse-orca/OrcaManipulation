  "xpbd_auto_discover": {
    "bodies": true,
    "cloth": true,
    "default_follow_mode": "kinematic",
    "body_track_scan_only": false,
    "comment_body_track": "仅 _XPBD_TRACK_GEOM；G1/openloong 通用，勿写死子串白名单",
    "body_include_geom_suffixes": [],
    "body_include_substrings": [
      "hand_thumb",
      "hand_index",
      "hand_middle",
      "wrist_yaw",
      "wrist_roll",
      "Cube"
