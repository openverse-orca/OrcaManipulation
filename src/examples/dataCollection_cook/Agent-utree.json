    "comment": "G1 Cook 手指 body 名匹配；排除 OpenLoong 2F85 夹爪名兜底",
    "body_exclude_substrings": [
      "gripper_l_inner_link4",
      "gripper_l_outer_link4",
      "gripper_r_inner_link4",
      "gripper_r_outer_link4",
      "arm_l_end_link",
      "arm_r_end_link"
