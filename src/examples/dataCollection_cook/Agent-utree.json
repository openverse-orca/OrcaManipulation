{
  "description": "G1 Omnipicker 机器人参数（关节/夹爪/body 匹配）。由 Config.json 的 agent_file 引用，深合并进主配置。",
  "run": {
    "agent": "g1_omnipicker",
    "mjc_prefix": "g1_cook2_usda"
  },
  "orcagym": {
    "mjc_agent_prefix": "g1_cook2_usda",
