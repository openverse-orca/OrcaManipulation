  "cloth": {
    "v4_parity": true,
    "mesh": "croissant_Low-copy.vtk",
    "finger_idle_collision": true,
    "mass_kg": 0.5,
    "edge_compliance": 0.5,
    "volume_compliance": 0.03,
    "compliance_damping": 0.012,
    "substeps": 16,
    "particle_restitution": 0.0,
    "particle_friction": 0.0,
    "comment_particle_friction": "粒子静=动摩擦。夹爪摩擦也低时，手–面包接触约取这两者的较大值（世界仍是 Max）。粘手就再降；桌上打滑不要靠它，去调 cube_*_friction。",
    "grip_side": "both",
    "lock_radius_m": 0.08,
    "comment_lock_radius_m": "旧局部锁粒半径（米，随后会乘 scene_scale）。grip_rigidify.enabled=true 时忽略此值，改为锁全部顶点。0=不按半径过滤。",
    "max_lock_approach_m": 2.0,
    "comment_max_lock_approach_m": "指尖中点到最近顶点超过此值则拒绝刚化。单位是 XPBD 内部米，不乘 scene_scale。填写=Studio真实米×20。2.0=Studio 10cm，方便三指包住可颂；隔空误抓→调小（1.0=5cm）；怎么都不触发→再确认单位。",
    "finger_close_ratio": 0.99,
    "comment_finger_close_ratio": "开度辅门：当前指间距 < 张开基线×该比例才允许刚化。比例不随 scene_scale 变。仅 require_pinch=true 时生效。可颂用 0.8（约收到全开的 80%）；要夹得更紧才刚化→调小（0.5 对面包过严）。",
    "grip_rigidify": {
      "enabled": true,
      "comment_enabled": "true：grip 后整块面包刚化并跟手走。false：仍走旧的局部锁粒。",
      "freeze_frame": "tip_mid",
      "comment_freeze_frame": "刚化坐标系。tip_mid=两指中点（推荐）；palm=掌心。跟手拧转不对时再试 palm。",
      "release_shape": "keep_grasped",
      "comment_release_shape": "松开后形状。keep_grasped=保持捏过的外形；restore_rest=弹回网格原始静止形。",
      "require_both_fingers_contact": true,
      "comment_require_both_fingers_contact": "true：该手两指代理盒附近都有足够面包粒子才刚化。锁太早（悬空跟着走）时保持 true。",
      "min_contacts_per_finger": 3,
      "comment_min_contacts_per_finger": "每指最少靠近的粒子数。误触发→调大；很难触发→调到 1。",
      "require_trigger": false,
      "comment_require_trigger": "是否还要求 Pico 扳机超过 0.5。dg_traj=pico 时建议 true；当前 cloth_robot 用 false。",
      "require_pinch": false,
      "comment_require_pinch": "是否还要求手指开度收到 finger_close_ratio。false：遥操双指碰到面包即可刚化。true：还要收到 finger_close_ratio。",
      "clamp_close": true,
      "comment_clamp_close": "刚化后禁止手指更合拢，防止抓穿刚化形体。",
      "clamp_mode": "trigger",
      "comment_clamp_mode": "trigger=刚化后扳机只许减小（第一版）。span=按刚化瞬间指间距钳 ctrl（需 XPBD 回传，后续再开）。",
      "close_margin_m": 0.04,
      "comment_close_margin_m": "判断「指碰到面包」时在包围球上加的余量。单位同样是 XPBD 米，不乘 20。0.04=Studio 2mm。刚化时盒子已叠进表面→略增大；两指离面包还有缝→略减小，不要变负。"
    },
    "comment_physics": "面包走四面体软体路径（经 mjc_pbd_bridge_cloth_softbody_config 读取）。目标「大形变 + 可回弹」：volume/edge_compliance 越大越软、形变越大（volume 是压扁主杠杆）；compliance_damping 越小回弹越强（0=关）；substeps 越大数值阻尼越小、回弹越强。当前 volume 0.05 是「大形变」起点，太塌就调小（0.05→0.02→0.01）。",
    "comment_grip": "第一版整块刚化：双指接触后锁全部顶点。跟随指为拇指+食指，见顶层 grip_bind。"
  },
  "grip_bind": {
    "comment": "刚化/锁粒跟随的两指（finger1=拇指，finger2=食指）。须带 left_/right_ 全名，否则左右手会绑到同一只手。与 Agent-utree.json 相同；合并后以此为准。",
    "left": {
      "palm_legacy": "gripper_l_palm",
      "palm_suffix": "left_wrist_yaw_link",
      "finger1_legacy": "gripper_l_finger1",
