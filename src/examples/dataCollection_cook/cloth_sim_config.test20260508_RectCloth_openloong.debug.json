{
  "description": "test20260508_RectCloth + openloong 全链路 debug：首帧 MuJoCo→OrcaLink→XPBD 与布初态比对",
  "extends": "cloth_sim_config.test20260508_RectCloth_openloong.json",
  "orcagym": {
    "debug_session": {
      "subdir_prefix": "cloth_debug",
      "comment": "CSV 写入 dataCollection_cloth/logs/cloth_debug_{timestamp}/"
    }
  },
  "debug": {
    "debug_mode": true,
    "publish_only": false,
    "export_csv": true,
    "export_recv_yup_csv": true,
    "export_anchor_substep_csv": true,
    "export_body_track_monitor_csv": true,
    "export_sync_seq_monitor": true,
    "export_macro_timing_pair": true,
    "export_macro_packet_pair_verify": false,
    "export_vertex_pos_compare": true,
    "export_cloth_vertex_capture": true,
    "cloth_vertex_capture_max": 64,
    "export_phys_trace": true,
    "export_cloth_init_compare": true,
    "cloth_init_compare_tolerance_mm": 5.0,
    "cloth_init_compare_wait_sec": 18.0,
    "export_cloth_orientation_compare": true,
    "cloth_orientation_compare_tolerance_deg": 5.0,
    "comment": "仅观测前20宏步：run_rect_cloth_substep_debug_20mf.sh；刚体子步→xpbd_body_track_substep.csv；布态→cloth_substep_trace.csv"
  },
  "xpbd": {
    "startup_delay": 12
  }
}
